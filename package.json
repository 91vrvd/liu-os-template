{
  "name": "desktop-portfolio-template",
  "description": "A customizable desktop-style personal website template.",
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "macos",
    "framer-motion",
    "tailwindcss",
    "personal-website",
    "vite"
  ],
  "author": "Contributors",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc -b && vite build",
    "build:china": "node scripts/prepare-cloudbase-mirror.mjs",
    "build:sites": "node scripts/prepare-sites-build.mjs && npm --prefix sites-shell run build && node scripts/stage-sites-build.mjs",
    "test:maps": "node scripts/test-maps.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "sync:ai": "node scripts/sync-ai-directory.mjs --resolve",
    "check:ai": "node scripts/validate-ai-directory.mjs",
    "check:ai:network": "node scripts/validate-ai-directory.mjs --network",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@e965/xlsx": "^0.20.3",
    "@fontsource/inter": "^5.2.8",
    "@types/three": "^0.185.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.24.7",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
}
